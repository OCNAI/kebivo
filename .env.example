# Copy to .env for Docker Compose. Keep .env private and backed up securely.
# See docs/self-hosting.md "Configuration" for every setting.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8000

# Add SECRET_KEY=<64 hex characters from `openssl rand -hex 32`> to .env.
# A stable key of at least 32 characters is required in production.
# Keep the same SECRET_KEY across restarts and database restores; changing it
# invalidates every project token. It does not encrypt database fields.

# Exact browser origins (scheme, host and port; no path) allowed to sign in.
# Use the URL you open in the browser, e.g. http://127.0.0.1:8000 locally or
# https://feedback.example.org behind a TLS proxy. Empty means no browser login.
# ALLOWED_ORIGINS=http://127.0.0.1:8000
# Proxy peer IPs whose X-Forwarded-For is trusted; leave empty without a proxy.
# TRUSTED_PROXY_IPS=127.0.0.1,::1

# `make dev` does not read .env; export variables in the shell instead.
# Per-process one-minute feedback limits; counters reset on restart.
FEEDBACK_RATE_LIMIT_PER_TOKEN=120
FEEDBACK_RATE_LIMIT_PER_IP=300
IDEMPOTENCY_WINDOW_HOURS=24
FEEDBACK_RETENTION_DAYS=180
DELIVERY_LOG_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=90
MCP_ENABLED=true
# Optional public host[:port] values accepted for MCP connections.
MCP_ALLOWED_HOSTS=

# Generate with `openssl rand -hex 32`; back up with the database.
# ENCRYPTION_KEY=<64 hex characters>
# During rotation only: previous key decrypts old blobs until reencrypt-secrets runs.
ENCRYPTION_KEY_PREVIOUS=
WORKER_ENABLED=true
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_SHUTDOWN_GRACE_SECONDS=20
DELIVERY_RETRY_SCHEDULE_SECONDS=30,120,600,1800,7200
DELIVERY_RETRY_AFTER_MAX_SECONDS=7200
